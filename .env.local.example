# Copy to .env.local and edit. Values are used as defaults on first launch;
# the Server screen in the app can override them (stored in the device keychain).
# Use your computer's LAN IP, not localhost. Android emulator: http://10.0.2.2:8042/dicom-web
EXPO_PUBLIC_DICOMWEB_URL=http://192.168.1.20:8042/dicom-web
EXPO_PUBLIC_DICOMWEB_USER=

# --- Cloud import (optional). Leave empty to hide a provider. See SETUP.md. ---
# Google Cloud console > APIs & Services > Credentials > OAuth client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Dropbox App Console > your app > Settings > App key
EXPO_PUBLIC_DROPBOX_APP_KEY=
